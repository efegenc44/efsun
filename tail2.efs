module Main

let main =
    let foldl = \op \acc \l match l
        | Empty       = acc
        | Cons ~x ~xs = foldl op (op acc x) xs
    in
    let one   = Succ Zero in
    let two   = Succ one  in
    let three = Succ two  in
    let list = Cons three (Cons two Empty) in
        foldl add Zero list

structure Pair[a b]
    | Pair a b

import Main.Pair in

structure Nat
    | Zero
    | Succ Nat

import Main.Nat in

let add = \n \m match Pair n m
    | Pair ~a Zero      = a
    | Pair ~a (Succ ~b) = Succ (add a b)

structure List[a]
    | Empty
    | Cons a List[a]

import Main.List in